node_modules/
apps/mobile/dist/
# Cargo build output at any depth: the root workspace builds into /target/, but a crate or plugin built on its own still writes its own target/
target/
apps/mobile/src-tauri/gen/
services/*/dist/
plugins/humid-gate/ios/.build/
plugins/humid-gate/android/.tauri/
plugins/humid-gate/ios/.tauri/
.data/
.DS_Store
deploy/windows/out/
deploy/linux/out/
plugins/humid-nfc/ios/.build/
plugins/humid-nfc/android/.tauri/
plugins/humid-nfc/ios/.tauri/
# cargo-fuzz crates (outside the workspace): their own target/ and run outputs
crates/*/fuzz/target/
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/
plugins/humid-docscan/android/.tauri/
plugins/humid-docscan/ios/.build/
plugins/humid-docscan/ios/.tauri/

# Secrets: never commit signing keys, key stores or environment files (PC-05).
# deploy/.gitignore also keeps deploy/.env out.
*.keystore
*.jks
*.p12
*.pfx
*.p8
keystore.properties
**/.env
# tools/tlog-cosign.mjs: the cosigner's key pair and its last-signed checkpoint
tlog-cosigner*.json
*.state.json
/data/
# The operator's trust configuration and downloaded lists (tools/trust.mjs)
deploy/trust/trust-config.json
deploy/trust/*.pem
deploy/trust/*.ml
deploy/trust/*.vical
