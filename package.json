{
  "name": "humid-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:pen": "node --test tests/pen/*.test.js",
    "test:timing": "node tools/timing-msg.mjs",
    "build:app": "npm run build -w @humid/mobile",
    "dev": "node tools/dev.mjs",
    "tauri": "npm run tauri -w @humid/mobile --",
    "changeset": "changeset",
    "version-modules": "changeset version",
    "affected": "node tools/affected.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/blindrsa-ts": "^0.4.6",
    "fake-indexeddb": "^6.2.2"
  }
}
