<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- A short buzz when a face or fingerprint check passes, a distinct one when it fails. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The camera: HumID QR codes (device links, recovery codes) and photos of documents and IDs,
         taken in the app. Optional: codes can be typed and photos chosen from the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Location: the optional "Stamp where it's sealed" on the seal screen. Asked for only
         when that screen opens with the stamp on; the location is kept in the document's
         encrypted details on this phone's own terms. Precise or approximate both work. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Android 12+: other apps' overlay windows are hidden while HumID is on screen. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Never back up or transfer HumID's data. The Keystore keys that unlock it can't
         leave this phone, so a restored copy (a reinstall, a new phone) is a HumID
         nothing can open: it would show "biometric key is gone" instead of setup.
         And a vault's wrapped keys and offline copy don't belong in a cloud backup. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/humid_no_backup" />
</manifest>
