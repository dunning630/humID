<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- A short buzz when a face or fingerprint check passes, a distinct one when it fails. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The camera: HumID QR codes (device links, recovery codes) and photos of documents and IDs,
         taken in the app. Optional: codes can be typed and photos chosen from the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 11+ hides other apps unless declared: without this, a web page's
         "take a photo" input can't find the camera app and falls back to the gallery. -->
    <!-- Never back up or transfer HumID's data. The Keystore keys that unlock it can't
         leave this phone, so a restored copy (a reinstall, a new phone) is a HumID
         nothing can open: it would show "biometric key is gone" instead of setup.
         And a vault's wrapped keys and offline copy don't belong in a cloud backup. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/humid_no_backup" />
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
