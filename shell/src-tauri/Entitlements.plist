<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Touch ID-protected keychain items live in the data-protection keychain,
       which requires an access group under the signing team's prefix.
       Replace TEAMID with your Apple Developer Team ID (CI does this from
       the APPLE_TEAM_ID secret). -->
  <key>keychain-access-groups</key>
  <array>
    <string>TEAMID.app.humid.vault</string>
  </array>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
