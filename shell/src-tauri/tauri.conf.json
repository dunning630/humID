{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HumID",
  "version": "../package.json",
  "identifier": "app.humid.vault",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "HumID",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#101412",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Biometrically gated post-quantum file vault",
    "longDescription": "HumID seals files with ML-KEM-1024 + X25519 and signs them with ML-DSA-87. Every key use requires a live biometric check on this device.",
    "copyright": "© 2026 Router and Router LLC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "minSdkVersion": 24
    },
    "linux": {
      "deb": { "depends": ["fprintd"] },
      "rpm": { "depends": ["fprintd"] }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
